# Scope City — local configuration
#
# Copy to .env and fill in. Nothing here is required to run the tests; it is
# only needed to run a real mission against a live TrueForge instance.

# ---------------------------------------------------------------------------
# Model keys
# ---------------------------------------------------------------------------
# Free Gemini keys, no card required: https://aistudio.google.com/apikey
#
# One key is enough to run a mission. Four means a free-tier rate limit does
# not end a demo halfway through -- Scope City rotates between them and only
# sidelines a key that actually refused.
#
# Use *different Google accounts*; several keys on one account share one quota
# and rotating between them achieves nothing.

# Which Gemini model every key points at. The TrueForge catalogue is a
# suggestion, not a restriction -- model_id is passed straight through, so any
# id Google currently serves works.
GEMINI_MODEL=gemini-2.5-flash

GEMINI_API_KEY_A=
GEMINI_API_KEY_B=
GEMINI_API_KEY_C=
GEMINI_API_KEY_D=

# ---------------------------------------------------------------------------
# Where things listen
# ---------------------------------------------------------------------------
# The harness. Note 127.0.0.1 rather than localhost: Node resolves localhost to
# ::1 while TrueForge listens on IPv4, which fails as a bare "fetch failed".
TRUEFORGE_BASE_URL=http://127.0.0.1:8790

# The scope proxy. SCOPE_PROXY_BIND is where it listens; PUBLIC_HOST is how the
# harness is told to reach it. They differ when TrueForge runs in WSL, a
# container, or on another machine.
SCOPE_PROXY_PORT=8791
# Keep the authenticated proxy local by default. Set this to 0.0.0.0 only when
# a non-mirrored WSL/container harness must cross a network namespace; the demo
# still generates and registers a fresh bearer token for every process.
SCOPE_PROXY_BIND=127.0.0.1
SCOPE_PROXY_PUBLIC_HOST=127.0.0.1

# Optional explicit override, best first. Empty means discover exactly the
# models that are actually registered in TrueForge, which is the safe default
# when any of B/C/D is left blank. `pnpm demo:models` prints a value to pin.
SCOPE_MODELS=

# Optional. TrueForge 0.1.4 accepts only Daytona as a sandbox provider, so
# without this the sandbox is unavailable and the brief omits its verification
# step. Everything else runs regardless.
DAYTONA_API_KEY=
SCOPE_SANDBOX=false

# ---------------------------------------------------------------------------
# Real demo systems (optional)
# ---------------------------------------------------------------------------
# Records can read and mutate issues in a repository you own. A fine-grained
# token needs Issues: read/write only. `tkt_7` maps to GitHub issue #7.
# Add repository-maintained labels `scope-city:order:ord_184` and
# `scope-city:email:customer@example.test`; the issue body remains untrusted.
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# A restricted Stripe test-mode key makes the Exchequer real. See README.
STRIPE_API_KEY=

# The Post House. Optional: without it, mail goes to an in-memory outbox.
#
# Mailpit is a local SMTP catcher with a web inbox, so "the mail reached only
# the authorised recipient" becomes something you can open rather than assert.
# No account, no credentials -- download the binary and run it:
#
#   ./mailpit --listen 127.0.0.1:8025 --smtp 127.0.0.1:1025
#
# Bind to localhost. Running it inside WSL and reaching it from Windows needs
# 0.0.0.0, which also puts an open relay and a readable inbox on whatever
# network the machine is on -- fine for a minute, not for a conference wifi.
#
# Then open http://127.0.0.1:8025 to watch messages arrive.
MAILPIT_HOST=
MAILPIT_PORT=1025

# A local model in the pool. Optional.
#
# The point is not that it is cheaper. The scope, the proxy, the ledger and the
# gate are identical whether the agent is Gemini or a Qwen on your laptop, and
# being able to swap the model and watch nothing about the enforcement change is
# the clearest demonstration that enforcement does not depend on trusting the
# model.
#
# Any OpenAI-compatible endpoint works -- Ollama, vLLM, a corporate gateway.
# TrueForge registers it as a `custom` provider, the same mechanism the Gemini
# slots already use.
#
#   ollama serve
#   ollama pull qwen2.5:3b
#   OLLAMA_HOST=http://127.0.0.1:11434
#   SCOPE_MODELS=local/qwen
#
# Pick the model for the machine, not for the benchmark. Measured on a laptop
# with an RTX 3050 (4 GB) and 16 GB of system memory:
#
#   qwen2.5:3b   runs a whole mission -- scope drafted, calls allowed at the
#                proxy, the refund held at the Gate for a countersign
#   qwen2.5:7b   fails to load: 4.7 GB of weights against 4 GB of VRAM, and
#                the host has no room to spill into
#
# The failure is a 500 from the provider carrying llama-server's own words
# ("out-of-memory during startup"), which reaches the operator as a mission
# that ended in error. If a mission dies immediately on a local model, look
# there before looking at the scope.
#
# Free memory matters as much as the model. The same 3b failed to allocate its
# KV cache with 0.7 GB of system memory free and ran the mission with 1.2 GB
# free -- so close a browser before recording a demo.
#
# Note that a local model may not accept a reasoning effort. Ollama answers one
# with `400 does not support thinking`, so the slot declares none and the
# control plane drops the operator's choice for that model rather than failing
# the launch. The turn budget still applies.
#
# It is registered but never discovered. Rotation treats models as
# interchangeable, which is true of four hosted keys and false of a 7B on a
# laptop, so a mission that rotated onto it when the keys were cooling did not
# fail -- it just became something nobody would watch. To use it, name it:
#
#   SCOPE_MODELS=local/qwen
OLLAMA_HOST=
OLLAMA_MODEL=qwen2.5:3b
# Only if your endpoint wants one. Ollama does not, and the slot registers
# without it; a gateway or a hosted vLLM behind auth takes its token here.
OLLAMA_API_KEY=
