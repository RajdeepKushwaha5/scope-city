# Scope City — local configuration
#
# Copy to .env and fill in. Nothing here is required to run the tests; it is
# only needed to run a real mission against a live TrueForge instance.

# ---------------------------------------------------------------------------
# Model keys
# ---------------------------------------------------------------------------
# Free Gemini keys, no card required: https://aistudio.google.com/apikey
#
# One key is enough to run a mission. Four means a free-tier rate limit does
# not end a demo halfway through -- Scope City rotates between them and only
# sidelines a key that actually refused.
#
# Use *different Google accounts*; several keys on one account share one quota
# and rotating between them achieves nothing.

# Which Gemini model every key points at. The TrueForge catalogue is a
# suggestion, not a restriction -- model_id is passed straight through, so any
# id Google currently serves works.
GEMINI_MODEL=gemini-2.5-flash

GEMINI_API_KEY_A=
GEMINI_API_KEY_B=
GEMINI_API_KEY_C=
GEMINI_API_KEY_D=

# ---------------------------------------------------------------------------
# Where things listen
# ---------------------------------------------------------------------------
# The harness. Note 127.0.0.1 rather than localhost: Node resolves localhost to
# ::1 while TrueForge listens on IPv4, which fails as a bare "fetch failed".
TRUEFORGE_BASE_URL=http://127.0.0.1:8790

# The scope proxy. SCOPE_PROXY_BIND is where it listens; PUBLIC_HOST is how the
# harness is told to reach it. They differ when TrueForge runs in WSL, a
# container, or on another machine.
SCOPE_PROXY_PORT=8791
# Keep the authenticated proxy local by default. Set this to 0.0.0.0 only when
# a non-mirrored WSL/container harness must cross a network namespace; the demo
# still generates and registers a fresh bearer token for every process.
SCOPE_PROXY_BIND=127.0.0.1
SCOPE_PROXY_PUBLIC_HOST=127.0.0.1

# Models to rotate across, best first. TrueForge addresses custom models as
# provider/model; remove slots whose key you left empty.
SCOPE_MODELS=gemini-a/flash-a,gemini-b/flash-b,gemini-c/flash-c,gemini-d/flash-d

# Optional. TrueForge 0.1.4 accepts only Daytona as a sandbox provider, so
# without this the sandbox is unavailable and the brief omits its verification
# step. Everything else runs regardless.
DAYTONA_API_KEY=
SCOPE_SANDBOX=false
