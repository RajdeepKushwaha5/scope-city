{
  "name": "scope-city",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @scope-city/server --filter @scope-city/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "demo:headless": "pnpm --filter @scope-city/demo headless",
    "city": "pnpm --filter @scope-city/city dev",
    "demo:models": "pnpm --filter @scope-city/demo models"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
